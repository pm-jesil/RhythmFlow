<?xml version="1.0" encoding="utf-8"?>
<!-- These drawables are referenced only by name from Dart
     (audio_service: "drawable/ic_shuffle", ...), which the release resource
     shrinker cannot see. Without this file they are removed from release
     APKs and the notification / lock-screen shuffle and repeat buttons lose
     their icons. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_shuffle,@drawable/ic_shuffle_ai,@drawable/ic_shuffle_off,@drawable/ic_repeat_all,@drawable/ic_repeat_one,@drawable/ic_repeat_off,@drawable/ic_stat_rhythmflow" />
