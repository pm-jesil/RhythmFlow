{
  "hosting": {
    "public": "policies",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/FIREBASE_HOSTING.md"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}

